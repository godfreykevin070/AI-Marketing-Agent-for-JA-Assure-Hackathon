
### `.env.example`

```dotenv
# ---------- Core ----------
ENVIRONMENT=development
DATABASE_URL=sqlite:///./ja_assure.db
# DATABASE_URL=postgresql+psycopg2://ja:ja@localhost:5432/ja_assure
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM (GroqCloud, OpenAI-compatible) ----------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant

# ---------- Research ----------
TAVILY_API_KEY=
SERPER_API_KEY=
PEXELS_API_KEY=your_key_here

# ---------- Publishing (Project 2) ----------
# dry_run | buffer | ayrshare
PUBLISHER_BACKEND=dry_run
BUFFER_API_KEY=
BUFFER_PROFILE_IDS={"linkedin":"","instagram":"","x":"","tiktok":""}
AYRSHARE_API_KEY=

# ---------- Media ----------
MEDIA_DIR=./media
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
ENABLE_VIDEO_RENDER=true

# ---------- Worker ----------
ENABLE_SCHEDULER=true
PUBLISH_POLL_SECONDS=60
MAX_COMPLIANCE_RETRIES=2

# ---------- Auth ----------
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_EMAIL=admin@jaassure.com
DEFAULT_ADMIN_PASSWORD=admin@123
DEFAULT_ADMIN_NAME=JA Assure Admin